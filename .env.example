# Client ID from https://developer.spotify.com/dashboard (your app → Settings).
# PKCE needs no client secret, so nothing secret ever ships to the browser.
VITE_SPOTIFY_CLIENT_ID=

# Must match a Redirect URI registered on the Spotify app exactly.
# Defaults to <current origin>/callback when unset.
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# Set to "true" to skip the ReccoBeats audio-feature lookup (it sends the
# Spotify track ID to api.reccobeats.com). Rings then use Spotify's own
# audio-features if your app has access, else the deterministic fallback.
VITE_DISABLE_RECCOBEATS=false

# Set to "true" to skip listening to the official 30-second Apple Music preview
# (it sends "artist title" to itunes.apple.com). Chakras are then estimated from the key.
VITE_DISABLE_PREVIEW_ANALYSIS=false
